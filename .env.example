# =============================================================
# MiroFish Configuration
# =============================================================
# Default setup runs on local models (Neo4j + Ollama) — no cloud APIs needed.
# You can also switch LLM and embeddings to Google Gemini or custom APIs
# (DeepSeek, OpenAI, vLLM, local proxies, etc.).
# Copy this file to .env and adjust values for your setup.
# =============================================================

# ===== 1. LLM Configuration (OpenAI-compatible format) =====
# --- Option A: Local Ollama (Default offline) ---
# For Docker: use service name "ollama" (http://ollama:11434/v1) instead of "localhost"
LLM_API_KEY=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL_NAME=qwen2.5:32b
# Lighter model for development (less VRAM):
# LLM_MODEL_NAME=qwen2.5:14b

# --- Option B: Google Gemini (OpenAI-compatible endpoint) ---
# LLM_API_KEY=your_gemini_api_key
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL_NAME=gemini-2.5-flash

# --- Option C: Custom Cloud API (DeepSeek, OpenAI, etc.) ---
# LLM_API_KEY=your_api_key
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL_NAME=deepseek-chat

# ===== 2. Neo4j Configuration =====
# For Docker bridge network: use service name "neo4j" (bolt://neo4j:7687)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=mirofish

# ===== 3. Embedding Configuration =====
# --- Option A: Local Ollama (Default offline, 768 dimensions) ---
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_DIMENSIONS=768
# For Docker: EMBEDDING_BASE_URL=http://ollama:11434

# --- Option B: Google Gemini API (Recommended for cloud embeddings) ---
# EMBEDDING_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_api_key
# EMBEDDING_MODEL=gemini-embedding-2
# EMBEDDING_DIMENSIONS=768

# --- Option C: Custom OpenAI-compatible Embedding API ---
# EMBEDDING_PROVIDER=openai
# EMBEDDING_API_KEY=your_api_key
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=768

# ===== 4. OASIS / CAMEL-AI Configuration =====
# CAMEL-AI reads OPENAI_API_KEY and OPENAI_API_BASE_URL
# Match this with your LLM configuration above:
# - For Ollama:
OPENAI_API_KEY=ollama
OPENAI_API_BASE_URL=http://localhost:11434/v1
# - For Gemini:
# OPENAI_API_KEY=your_gemini_api_key
# OPENAI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# - For DeepSeek:
# OPENAI_API_KEY=your_deepseek_api_key
# OPENAI_API_BASE_URL=https://api.deepseek.com

# ===== 5. Docker Mode Overrides =====
# When running inside Docker (bridge mode):
# LLM_BASE_URL=http://ollama:11434/v1
# NEO4J_URI=bolt://neo4j:7687
# EMBEDDING_BASE_URL=http://ollama:11434
# OPENAI_API_BASE_URL=http://ollama:11434/v1
#
# If talking to a service on your host machine from inside Docker:
# LLM_BASE_URL=http://host.docker.internal:20128/v1
# OPENAI_API_BASE_URL=http://host.docker.internal:20128/v1

# ===== 6. Flask Server Configuration =====
FLASK_HOST=0.0.0.0
FLASK_PORT=5001
FLASK_DEBUG=false
SECRET_KEY=mirofish-secret-key-change-in-production

# ===== 7. Simulation & Report Parameters =====
OASIS_DEFAULT_MAX_ROUNDS=10
REPORT_AGENT_MAX_TOOL_CALLS=15
REPORT_AGENT_MAX_REFLECTION_ROUNDS=3
REPORT_AGENT_TEMPERATURE=0.7

# ===== 8. Frontend Configuration =====
VITE_API_BASE_URL=http://localhost:5001
